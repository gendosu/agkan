        },
        {
          "name": "agkan task list",
          "desc": "List tasks",
          "syntax": "agkan task list [options]",
          "opts": [
            ["-s, --status <status>", "Filter by status (comma-separated)"],
            ["-a, --author <author>", "Filter by author"],
            ["--assignees <assignees>", "Filter by assignee"],
            ["-t, --tag <tags>", "Filter by tag name(s) or ID(s), comma-separated"],
            ["-p, --priority <priorities>", "Filter by priority, comma-separated"],
            ["--all", "Include all statuses (icebox, done, and closed)"],
            ["--archived", "Include archived tasks (is_archived=1)"],
