          "examples": [
            "agkan task list",
            "agkan task list --status in_progress",
            "agkan task list --tag backend --priority high,critical",
            "agkan task list --tree",
            "agkan task list --all --json"
          ]
        },
        {
          "name": "agkan task get",
          "desc": "Get a task by ID (alias: show)",
          "syntax": "agkan task get <id> [--json]",
          "opts": [["--json", "Output as JSON"]],
          "examples": ["agkan task get 42", "agkan task get 42 --json", "agkan task show 42"]
        },
        {
          "name": "agkan task update",
          "desc": "Update a task",
          "syntax": "agkan task update <id> [field] [value] [options]",
          "opts": [
            ["--title <title>", "New title"],
            ["--status <status>", "New status"],
            ["--body <body>", "New body text"],
            ["--author <author>", "New author"],
            ["--assignees <list>", "Comma-separated assignee names"],
            ["-p, --priority <priority>", "New priority (or empty to clear)"],
            ["--branch <branch>", "New git branch name (or empty to clear)"],
            ["--model-planning <alias>", "Update planning model (fable, opus, sonnet, haiku, or empty to clear)"],
            ["--model-run <alias>", "Update run model (fable, opus, sonnet, haiku, or empty to clear)"],
            ["--effort-planning <level>", "Update planning reasoning effort (low, medium, high, xhigh, max, or empty to clear)"],
            ["--effort-run <level>", "Update run reasoning effort (low, medium, high, xhigh, max, or empty to clear)"],
            ["--file <path>", "Read body from file (body field only)"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task update 1 --status review",
            "agkan task update 1 --title \"Updated title\"",
            "agkan task update 1 --priority high",
            "agkan task update 1 status review   # legacy positional syntax"
          ]
        },
        {
          "name": "agkan task find",
          "desc": "Search tasks by keyword",
          "syntax": "agkan task find <keyword> [options]",
          "opts": [
            ["--all", "Include done/closed tasks"],
            ["--archived", "Include archived tasks"],
            ["--status <statuses>", "Filter by status, comma-separated"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task find \"login\"",
            "agkan task find \"bug\" --all",
            "agkan task find \"bug\" --status ready,in_progress"
          ]
        },
        {
          "name": "agkan task count",
          "desc": "Show task count by status",
          "syntax": "agkan task count [options]",
          "opts": [
            ["-s, --status <status>", "Filter to a specific status"],
            ["-q, --quiet", "Numbers only (script-friendly)"],
            ["--json", "Output as JSON"]
          ],
          "examples": ["agkan task count", "agkan task count --status in_progress", "agkan task count -s ready -q"]
        },
        {
          "name": "agkan task block",
          "desc": "Manage blocking relationships between tasks",
          "syntax": "agkan task block <add|remove|list> ...",
          "opts": [
            ["add <blocker-id> <blocked-id>", "Add a blocking relationship (blocker-id blocks blocked-id)"],
            ["remove <blocker-id> <blocked-id>", "Remove a blocking relationship"],
            ["list <id>", "List all blocking relationships for a task"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task block add 1 2    # task 1 blocks task 2",
            "agkan task block remove 1 2",
            "agkan task block list 1"
          ]
        },
        {
          "name": "agkan task delete",
          "desc": "Delete a task",
          "syntax": "agkan task delete <id> [options]",
          "opts": [
            ["--dry-run", "Preview the impact of deletion without deleting"],
            ["--json", "Output as JSON"]
          ],
          "examples": ["agkan task delete 42", "agkan task delete 42 --dry-run"]
        },
        {
          "name": "agkan task comment",
          "desc": "Manage comments on a task",
          "syntax": "agkan task comment <add|list|update|delete> ...",
          "opts": [
            ["add <task-id> <content>", "Add a comment to a task"],
            ["list <task-id>", "List all comments for a task"],
            ["update <comment-id> <content>", "Update a comment by ID"],
            ["delete <comment-id>", "Delete a comment by ID"],
            ["--author <author>", "Comment author (add only)"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task comment add 1 \"Looks good\" --author claude",
            "agkan task comment list 1",
            "agkan task comment update 5 \"Updated content\"",
            "agkan task comment delete 5"
          ]
        },
        {
          "name": "agkan task meta",
          "desc": "Manage task metadata",
          "syntax": "agkan task meta <set|get|list|delete> ...",
          "opts": [
            ["set <task-id> <key> <value>", "Set metadata for a task"],
            ["get <task-id> <key>", "Get metadata for a task"],
            ["list <task-id>", "List all metadata for a task"],
            ["delete <task-id> <key>", "Delete metadata for a task"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task meta set 1 branch feature/login",
            "agkan task meta get 1 branch",
            "agkan task meta list 1",
            "agkan task meta delete 1 branch"
          ]
        },
        {
          "name": "agkan task archive",
          "desc": "Archive done/closed tasks older than a given date (sets is_archived flag)",
          "syntax": "agkan task archive [options]",
          "opts": [
            ["--before <date>", "Archive tasks updated before this date (default: 3 days ago)"],
            ["--status <statuses>", "Comma-separated statuses to target (default: done,closed)"],
            ["--dry-run", "Preview without modifying"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task archive",
            "agkan task archive --before 2026-01-01",
            "agkan task archive --status done --dry-run"
          ]
        },
        {
          "name": "agkan task unarchive",
          "desc": "Unarchive a task (clears is_archived flag)",
          "syntax": "agkan task unarchive <id> [options]",
          "opts": [
            ["--dry-run", "Preview without modifying"],
            ["--json", "Output as JSON"]
          ],
          "examples": ["agkan task unarchive 42", "agkan task unarchive 42 --dry-run"]
        },
        {
          "name": "agkan task copy",
          "desc": "Copy a task by ID",
          "syntax": "agkan task copy <id> [options]",
          "opts": [
            ["-s, --status <status>", "Status for the copied task (default: backlog)"],
            ["--no-tags", "Do not copy tags"],
            ["--json", "Output as JSON"]
          ],
          "examples": ["agkan task copy 42", "agkan task copy 42 --status ready", "agkan task copy 42 --no-tags"]
        },
        {
          "name": "agkan task purge",
          "desc": "Delete done/closed tasks older than a given date to reduce database size",
          "syntax": "agkan task purge [options]",
          "opts": [
            ["--before <date>", "Purge tasks updated before this date (default: 3 days ago)"],
            ["--status <statuses>", "Comma-separated statuses to target (default: done,closed)"],
            ["--dry-run", "Preview without modifying"],
            ["--json", "Output as JSON"]
          ],
          "examples": [
            "agkan task purge --before 2026-01-01",
            "agkan task purge --dry-run",
            "agkan task purge --status closed"
          ]
        },
        {
          "name": "agkan task update-parent",
          "desc": "Update task parent (use null/none to remove)",
          "syntax": "agkan task update-parent <id> <parent_id> [options]",
          "opts": [["--json", "Output as JSON"]],
          "examples": ["agkan task update-parent 5 1", "agkan task update-parent 5 none"]
        }
